rules_version = '2';

// ─── TecniControl – Reglas de Seguridad de Firestore ────────────────────────
//
// Colecciones de nivel raíz:
//   users/{uid}                   – Perfil/actividad del usuario (AuthProvider)
//   clientes/{clienteId}          – Clientes por usuario
//   ordenes/{ordenId}             – Órdenes de servicio
//   negocios/{userId}             – Perfil de negocio (doc ID = UID del dueño)
//   contadores/{contadorId}       – Contadores: por UID (multiuser-helpers) y
//                                   por tipo 'ordenesMantenimiento', etc. (firebase-utils)
//   userConfig/{userId}           – Configuración del usuario
//     └─ tareas/{tareaId}         – Subcollección: tareas predefinidas
//     └─ piezas/{piezaId}         – Subcollección: piezas predefinidas

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones de ayuda ────────────────────────────────────────────────────

    /// Devuelve true si el request viene de un usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Devuelve true si el UID del token coincide con el campo userId pasado
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /// Verifica que el campo userId del payload entrante sea el mismo UID del token
    function incomingUserId() {
      return request.resource.data.userId == request.auth.uid;
    }


    function isNonEmptyString(field) {
      return request.resource.data[field] is string
             && request.resource.data[field].size() > 0;
    }

    function isOptionalString(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] is string;
    }

    function isOptionalBool(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] is bool;
    }

    function isOptionalNumber(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] is number;
    }

    function isOptionalMap(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] is map;
    }

    function isOptionalList(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] is list;
    }

    function isTimestampOrString(field) {
      return !request.resource.data.keys().hasAny([field])
             || request.resource.data[field] is timestamp
             || request.resource.data[field] is string;
    }

    function validClientePayload() {
      return request.resource.data.userId == request.auth.uid
             && request.resource.data.keys().hasOnly([
                  'id', 'userId', 'name', 'cedula', 'email', 'phone',
                  'address', 'dispositivos', 'createdAt', 'updatedAt'
                ])
             && isOptionalString('id')
             && isNonEmptyString('name')
             && isOptionalString('cedula')
             && isOptionalString('email')
             && isOptionalString('phone')
             && isOptionalString('address')
             && isOptionalList('dispositivos')
             && isTimestampOrString('createdAt')
             && isTimestampOrString('updatedAt');
    }

    function validNegocioPayload() {
      return request.resource.data.userId == request.auth.uid
             && request.resource.data.keys().hasOnly([
                  'id', 'userId', 'nombre', 'direccion', 'telefono',
                  'email', 'nit', 'logoUrl', 'onboardingCompleted', 'createdAt', 'updatedAt'
                ])
             && isOptionalString('id')
             && isOptionalString('nombre')
             && isOptionalString('direccion')
             && isOptionalString('telefono')
             && isOptionalString('email')
             && isOptionalString('nit')
             && isOptionalString('logoUrl')
             && isOptionalBool('onboardingCompleted')
             && isTimestampOrString('createdAt')
             && isTimestampOrString('updatedAt');
    }

    function validOrdenPayload() {
      return request.resource.data.userId == request.auth.uid
             && request.resource.data.keys().hasOnly([
                  'id', 'userId', 'idPersonalizado', 'tipo', 'clienteId',
                  'dispositivoId', 'cliente', 'dispositivo', 'fechaCreacion',
                  'horaCreacion', 'observacionesIniciales', 'pruebasRealizadas',
                  'posiblesCausas', 'diagnosticoFinal', 'contadorMaquina',
                  'contador', 'tipoMantenimiento', 'tareasRealizadas',
                  'piezasUsadas', 'garantiaTiempoDesde', 'garantiaTiempoHasta',
                  'garantiaDescripcion', 'garantiaHabilitada', 'garantiaReferenciaId', 'garantiaMotivo',
                  'instalacionRecomendaciones',
                  'instalacionRecomendacionesDetalle', 'instalacionConfiguracion',
                  'instalacionConfiguracionTipos', 'firmaCliente',
                  'nombreFirmante', 'validacionCliente', 'createdAt', 'updatedAt'
                ])
             && isOptionalString('id')
             && request.resource.data.tipo == 'mantenimiento'
             && request.resource.data.clienteId is string
             && request.resource.data.dispositivoId is string
             && request.resource.data.horaCreacion is string
             && request.resource.data.tipoMantenimiento in ['preventivo', 'correctivo', 'diagnostico', 'instalacion', 'garantia']
             && isOptionalMap('cliente')
             && isOptionalMap('dispositivo')
             && isOptionalList('tareasRealizadas')
             && isOptionalList('piezasUsadas')
             && isTimestampOrString('fechaCreacion')
             && isTimestampOrString('garantiaTiempoDesde')
             && isTimestampOrString('garantiaTiempoHasta')
             && isOptionalString('observacionesIniciales')
             && isOptionalString('pruebasRealizadas')
             && isOptionalString('posiblesCausas')
             && isOptionalString('diagnosticoFinal')
             && isOptionalString('garantiaDescripcion')
             && isOptionalString('garantiaReferenciaId')
             && isOptionalString('garantiaMotivo')
             && isOptionalString('instalacionRecomendacionesDetalle')
             && isOptionalList('instalacionConfiguracionTipos')
             && isOptionalString('firmaCliente')
             && isOptionalString('nombreFirmante')
             && isOptionalBool('garantiaHabilitada')
             && isOptionalBool('instalacionRecomendaciones')
             && isOptionalBool('instalacionConfiguracion')
             && isOptionalBool('validacionCliente');
    }

    function validTareaPayload() {
      return request.resource.data.keays().hasOnly(['nombre', 'tipo', 'categoria', 'creadoEn', 'actualizadoEn'])
             && isNonEmptyString('nombre')
             && request.resource.data.tipo in ['preventivo', 'correctivo', 'ambos']
             && isNonEmptyString('categoria')
             && isTimestampOrString('creadoEn')
             && isTimestampOrString('actualizadoEn');
    }

    function validPiezaPayload() {
      return request.resource.data.keys().hasOnly(['nombre', 'categoria', 'creadoEn', 'actualizadoEn'])
             && isNonEmptyString('nombre')
             && isNonEmptyString('categoria')
             && isTimestampOrString('creadoEn')
             && isTimestampOrString('actualizadoEn');
    }

    // ── users ─────────────────────────────────────────────────────────────────
    //  • Creado por AuthProvider al hacer sign-in (campos: uid, email, role, etc.)
    //  • El docId es el UID del usuario; solo él puede leer o escribir su propio doc.

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    // Impedir que el usuario cambie su propio rol, UID o plan (usando diff para mayor robustez)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'plan'])
                    // Lógica de Device Binding: Si ya tiene un deviceId, no puede cambiarlo
                    && (!('deviceId' in resource.data) || request.resource.data.deviceId == resource.data.deviceId);
      allow delete: if false;
    }

    // ── clientes ──────────────────────────────────────────────────────────────
    //  • Cada cliente pertenece al técnico que lo creó (campo userId).
    //  • Solo ese técnico puede leer, crear, actualizar o eliminar sus clientes.

    match /clientes/{clienteId} {
      allow read: if isAuthenticated()
                     && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
                       && validClientePayload();

      allow update: if isAuthenticated()
                       && resource.data.userId == request.auth.uid
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.keys().hasOnly([
                            'id', 'userId', 'name', 'cedula', 'email', 'phone',
                            'address', 'dispositivos', 'createdAt', 'updatedAt'
                          ])
                       && isOptionalString('id')
                       && isOptionalString('cedula')
                       && isOptionalString('email')
                       && isOptionalString('phone')
                       && isOptionalString('address')
                       && isOptionalList('dispositivos')
                       && isTimestampOrString('updatedAt');

      allow delete: if isAuthenticated()
                       && resource.data.userId == request.auth.uid;
    }

    // ── ordenes ───────────────────────────────────────────────────────────────
    //  • Cada orden lleva el campo userId del técnico emisor.
    //  • Solo ese técnico puede ver o modificar sus órdenes.
    //  • El tipo debe ser 'mantenimiento'.

    match /ordenes/{ordenId} {
      allow read: if isAuthenticated()
                     && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
                       && validOrdenPayload();

      allow update: if isAuthenticated()
                       && resource.data.userId == request.auth.uid
                       && request.resource.data.userId == resource.data.userId
                       && request.resource.data.keys().hasOnly([
                            'id', 'userId', 'idPersonalizado', 'tipo', 'clienteId',
                            'dispositivoId', 'cliente', 'dispositivo', 'fechaCreacion',
                            'horaCreacion', 'observacionesIniciales', 'pruebasRealizadas',
                            'posiblesCausas', 'diagnosticoFinal', 'contadorMaquina',
                            'contador', 'tipoMantenimiento', 'tareasRealizadas',
                            'piezasUsadas', 'garantiaTiempoDesde', 'garantiaTiempoHasta',
                            'garantiaDescripcion', 'garantiaHabilitada', 'garantiaReferenciaId', 'garantiaMotivo',
                            'instalacionRecomendaciones',
                            'instalacionRecomendacionesDetalle', 'instalacionConfiguracion',
                            'instalacionConfiguracionTipos', 'firmaCliente',
                            'nombreFirmante', 'validacionCliente', 'createdAt', 'updatedAt'
                          ])
                       && isOptionalString('id')
                       && request.resource.data.tipo == 'mantenimiento'
                       && request.resource.data.tipoMantenimiento in ['preventivo', 'correctivo', 'diagnostico', 'instalacion', 'garantia'];

      allow delete: if isAuthenticated()
                       && resource.data.userId == request.auth.uid;
    }

    // ── negocios ──────────────────────────────────────────────────────────────
    //  • El documento ID es el mismo UID del técnico.
    //  • Solo el propietario puede acceder a su perfil de negocio.

    match /negocios/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && validNegocioPayload();
      allow update: if isOwner(userId)
                       && request.resource.data.userId == userId
                       && validNegocioPayload();
      allow delete: if isOwner(userId);
    }

    // ── search_indices ────────────────────────────────────────────────────────
    //  • El documento ID es el mismo UID del técnico.
    //  • Solo el propietario puede acceder a su índice de búsqueda.

    match /search_indices/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId) && isOptionalMap('ordenes');
      allow update: if isOwner(userId) && isOptionalMap('ordenes');
      allow delete: if isOwner(userId);
    }

    // ── contadores ────────────────────────────────────────────────────────────
    //  Hay DOS tipos de documentos en esta colección:
    //
    //  1. contadores/{uid}  — por usuario (multiuser-helpers.ts)
    //     El campo 'siguiente' solo puede incrementarse.
    //
    //  2. contadores/ordenesMantenimiento | ordenesDiagnostico | ...
    //     Contadores globales por TIPO de orden (firebase-utils.ts).
    //     Cualquier usuario autenticado puede leer y actualizar (transacción);
    //     el campo 'ultimoNumero' solo puede crecer.

    match /contadores/{contadorId} {
      // Lectura: el propio usuario (si es su doc de UID) o cualquier auth (contador global)
      allow read: if isAuthenticated()
                     && (request.auth.uid == contadorId
                         || contadorId.matches('ordenes(Mantenimiento|Diagnostico|Entrega)'));

      // Creación: solo el propio usuario para su doc de UID,
      // o cualquier autenticado para contadores globales (firebase-utils crea en transacción)
      allow create: if isAuthenticated()
                       && (request.auth.uid == contadorId
                             ? incomingUserId()
                             : contadorId.matches('ordenes(Mantenimiento|Diagnostico|Entrega)'))
                       && request.resource.data.keys().hasOnly([
                            'userId', 'siguiente', 'ultimaOrden',
                            'fechaActualizacion', 'ultimoNumero', 'siguientePorAnio'
                          ])
                       && isOptionalMap('siguientePorAnio');

      // Actualización: igual que create, pero ultimoNumero/siguiente solo sube
      allow update: if isAuthenticated()
                       && (request.auth.uid == contadorId
                             ? (request.resource.data.userId == contadorId
                                && request.resource.data.siguiente >= resource.data.siguiente
                                && request.resource.data.keys().hasOnly([
                                     'userId', 'siguiente', 'ultimaOrden',
                                     'fechaActualizacion', 'siguientePorAnio'
                                   ])
                                && isOptionalMap('siguientePorAnio'))
                             : (contadorId.matches('ordenes(Mantenimiento|Diagnostico|Entrega)')
                                && request.resource.data.ultimoNumero >= resource.data.ultimoNumero
                                && request.resource.data.keys().hasOnly(['ultimoNumero'])));

      allow delete: if false;
    }

    // ── userConfig ────────────────────────────────────────────────────────────
    //  • Documento raíz de configuración; el docId es el UID del técnico.

    match /userConfig/{userId} {
      allow read:  if isOwner(userId);
      allow write: if isOwner(userId)
                       && request.resource.data.keys().hasOnly([
                            'migradoV2', 'tareasPredefinidas', 'piezasPredefinidas',
                            'inicializado', 'inicializadoPiezas'
                          ])
                       && (!request.resource.data.keys().hasAny(['migradoV2'])
                            || request.resource.data.migradoV2 is bool)
                       && (!request.resource.data.keys().hasAny(['tareasPredefinidas'])
                            || request.resource.data.tareasPredefinidas is list)
                       && (!request.resource.data.keys().hasAny(['piezasPredefinidas'])
                            || request.resource.data.piezasPredefinidas is list)
                       && (!request.resource.data.keys().hasAny(['inicializado'])
                            || request.resource.data.inicializado is bool)
                       && (!request.resource.data.keys().hasAny(['inicializadoPiezas'])
                            || request.resource.data.inicializadoPiezas is bool);

      match /tareas/{tareaId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                         && validTareaPayload();

        allow update: if isOwner(userId)
                         && validTareaPayload();

        allow delete: if isOwner(userId);
      }

      match /piezas/{piezaId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                         && validPiezaPayload();

        allow update: if isOwner(userId)
                         && validPiezaPayload();

        allow delete: if isOwner(userId);
      }
    }

    // ── Denegación global ─────────────────────────────────────────────────────
    //  Cualquier colección no listada queda bloqueada por defecto (principio
    //  de mínimo privilegio).

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
